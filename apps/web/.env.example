# Local Supabase (`pnpm db:start`; values from `pnpm supabase status`).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Optional: error reporting.
VITE_SENTRY_DSN=
# Comma-separated OAuth providers enabled in Supabase Auth (google, azure). Empty until the apps exist.
VITE_AUTH_PROVIDERS=
