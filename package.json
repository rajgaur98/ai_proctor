{
  "name": "ai-proctor",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/contracts/src/database.types.ts && biome format --write packages/contracts/src/database.types.ts",
    "contracts:gen": "pnpm --filter @ai-proctor/contracts gen",
    "contracts:migration": "pnpm --filter @ai-proctor/contracts migration",
    "contracts:check-db": "pnpm --filter @ai-proctor/contracts check-db"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22",
    "supabase": "2.121.0",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  }
}
