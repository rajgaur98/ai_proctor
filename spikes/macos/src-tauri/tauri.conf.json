{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Proctor Spike",
  "version": "0.0.0",
  "identifier": "com.aiproctor.spike.macos",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Spike control",
        "url": "index.html",
        "width": 520,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"]
  }
}
