{
  "name": "@ai-proctor/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas for RPC payloads and events, exported as JSON Schema for the Rust agent",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests",
    "gen": "node scripts/gen-json-schema.ts && biome format --write generated",
    "migration": "node scripts/contract-migration.ts",
    "check-db": "node scripts/check-db.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
