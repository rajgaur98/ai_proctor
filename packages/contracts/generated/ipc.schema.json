{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Proctor agent IPC",
  "definitions": {
    "PermissionState": {
      "type": "string",
      "enum": ["granted", "denied", "not_determined", "restricted", "unsupported"]
    },
    "Permissions": {
      "type": "object",
      "properties": {
        "screen": {
          "$ref": "#/definitions/PermissionState"
        },
        "camera": {
          "$ref": "#/definitions/PermissionState"
        }
      },
      "required": ["screen", "camera"],
      "additionalProperties": false
    },
    "ShiftState": {
      "type": "string",
      "enum": ["off_shift", "working", "on_break", "paused"]
    },
    "ProjectRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "client": {
          "type": ["string", "null"]
        }
      },
      "required": ["id", "name", "client"],
      "additionalProperties": false
    },
    "CheckinOutcome": {
      "type": "string",
      "enum": ["pass", "miss", "failed"]
    },
    "LastCheckin": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/definitions/CheckinOutcome"
        }
      },
      "required": ["at", "outcome"],
      "additionalProperties": false
    },
    "MissedCheckin": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      },
      "required": ["id", "at"],
      "additionalProperties": false
    },
    "NoticeStatus": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "acknowledged": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": ["version", "acknowledged", "required"],
      "additionalProperties": false
    },
    "NoticeBody": {
      "type": "object",
      "properties": {
        "intro": {
          "type": "string"
        },
        "collected": {
          "type": "string"
        },
        "when": {
          "type": "string"
        },
        "who": {
          "type": "string"
        },
        "retention": {
          "type": "string"
        },
        "rights": {
          "type": "string"
        },
        "grievance": {
          "type": "string"
        }
      },
      "required": ["collected", "when", "who", "retention", "rights"],
      "additionalProperties": false
    },
    "NoticeContent": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "acknowledged": {
          "type": "boolean"
        },
        "body": {
          "$ref": "#/definitions/NoticeBody"
        }
      },
      "required": ["version", "acknowledged", "body"],
      "additionalProperties": false
    },
    "AgentStatus": {
      "type": "object",
      "properties": {
        "shift": {
          "$ref": "#/definitions/ShiftState"
        },
        "signed_in": {
          "type": "boolean"
        },
        "account_email": {
          "type": ["string", "null"]
        },
        "agent_version": {
          "type": "string"
        },
        "permissions": {
          "$ref": "#/definitions/Permissions"
        },
        "clocked_in_at": {
          "type": ["string", "null"]
        },
        "phase_started_at": {
          "type": ["string", "null"]
        },
        "pause_ends_at": {
          "type": ["string", "null"]
        },
        "pause_planned_min": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "worked_today_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pause_used_today_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pause_daily_cap_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "project": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProjectRef"
          }
        },
        "last_checkin": {
          "anyOf": [
            {
              "$ref": "#/definitions/LastCheckin"
            },
            {
              "type": "null"
            }
          ]
        },
        "missed_checkin": {
          "anyOf": [
            {
              "$ref": "#/definitions/MissedCheckin"
            },
            {
              "type": "null"
            }
          ]
        },
        "notice": {
          "anyOf": [
            {
              "$ref": "#/definitions/NoticeStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "accessibility_missing": {
          "type": "boolean"
        }
      },
      "required": [
        "shift",
        "signed_in",
        "account_email",
        "agent_version",
        "permissions",
        "clocked_in_at",
        "phase_started_at",
        "pause_ends_at",
        "pause_planned_min",
        "worked_today_s",
        "pause_used_today_s",
        "pause_daily_cap_s",
        "project",
        "projects",
        "last_checkin",
        "missed_checkin",
        "notice",
        "accessibility_missing"
      ],
      "additionalProperties": false
    },
    "CommandResult": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": ["string", "null"]
        }
      },
      "required": ["ok", "error"],
      "additionalProperties": false
    },
    "CardChallenge": {
      "type": "object",
      "properties": {
        "card_id": {
          "type": "string"
        },
        "target": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "options": {
          "minItems": 3,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "remaining_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wrong_clicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sound": {
          "type": "boolean"
        },
        "project": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "card_id",
        "target",
        "options",
        "remaining_s",
        "wrong_clicks",
        "sound",
        "project"
      ],
      "additionalProperties": false
    },
    "CardClickResult": {
      "type": "string",
      "enum": ["pass", "wrong", "failed", "ignored"]
    },
    "PermissionKind": {
      "type": "string",
      "enum": ["screen", "camera", "accessibility"]
    },
    "OnboardingPlatform": {
      "type": "string",
      "enum": ["macos", "windows", "other"]
    },
    "OnboardingState": {
      "type": "object",
      "properties": {
        "platform": {
          "$ref": "#/definitions/OnboardingPlatform"
        },
        "permissions": {
          "$ref": "#/definitions/Permissions"
        },
        "webcam": {
          "type": "boolean"
        },
        "accessibility": {
          "$ref": "#/definitions/PermissionState"
        },
        "domains": {
          "type": "boolean"
        },
        "ready": {
          "type": "boolean"
        },
        "restart_needed": {
          "type": "boolean"
        },
        "completed": {
          "type": "boolean"
        },
        "start_step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "platform",
        "permissions",
        "webcam",
        "accessibility",
        "domains",
        "ready",
        "restart_needed",
        "completed",
        "start_step"
      ],
      "additionalProperties": false
    },
    "TestCaptureFailure": {
      "type": "string",
      "enum": ["permission_missing", "camera_busy", "no_camera", "failed"]
    },
    "TestCaptureResult": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "screens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "webcam": {
          "type": ["string", "null"]
        },
        "screen_error": {
          "anyOf": [
            {
              "$ref": "#/definitions/TestCaptureFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "webcam_error": {
          "anyOf": [
            {
              "$ref": "#/definitions/TestCaptureFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "restart_needed": {
          "type": "boolean"
        }
      },
      "required": ["ok", "screens", "webcam", "screen_error", "webcam_error", "restart_needed"],
      "additionalProperties": false
    }
  }
}
