{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Proctor agent IPC",
  "definitions": {
    "PermissionState": {
      "type": "string",
      "enum": ["granted", "denied", "not_determined", "restricted", "unsupported"]
    },
    "Permissions": {
      "type": "object",
      "properties": {
        "screen": {
          "$ref": "#/definitions/PermissionState"
        },
        "camera": {
          "$ref": "#/definitions/PermissionState"
        }
      },
      "required": ["screen", "camera"],
      "additionalProperties": false
    },
    "ShiftState": {
      "type": "string",
      "enum": ["off_shift", "working", "on_break", "paused"]
    },
    "AgentStatus": {
      "type": "object",
      "properties": {
        "shift": {
          "$ref": "#/definitions/ShiftState"
        },
        "signed_in": {
          "type": "boolean"
        },
        "account_email": {
          "type": ["string", "null"]
        },
        "agent_version": {
          "type": "string"
        },
        "permissions": {
          "$ref": "#/definitions/Permissions"
        }
      },
      "required": ["shift", "signed_in", "account_email", "agent_version", "permissions"],
      "additionalProperties": false
    },
    "CommandResult": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": ["string", "null"]
        }
      },
      "required": ["ok", "error"],
      "additionalProperties": false
    },
    "CardChallenge": {
      "type": "object",
      "properties": {
        "card_id": {
          "type": "string"
        },
        "target": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "options": {
          "minItems": 3,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "remaining_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wrong_clicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sound": {
          "type": "boolean"
        },
        "project": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "card_id",
        "target",
        "options",
        "remaining_s",
        "wrong_clicks",
        "sound",
        "project"
      ],
      "additionalProperties": false
    },
    "CardClickResult": {
      "type": "string",
      "enum": ["pass", "wrong", "failed", "ignored"]
    }
  }
}
